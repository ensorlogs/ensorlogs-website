# =============================================================================
# .htaccess — qué es y cómo leer este archivo (modo enseñanza)
# =============================================================================
#
# Apache busca ".htaccess" en cada carpeta y aplica reglas **solo a esa rama**
# del sitio (a diferencia de httpd.conf, que es global del servidor).
#
# Convención en este proyecto:
#   1) Cabeceras HTTP de seguridad (mod_headers).
#   2) Opciones de carpeta (Options -Indexes).
#   3) Redirección HTTPS en producción (mod_rewrite).
#   4) Compresión gzip/deflate (mod_deflate).
#   5) Caché del navegador con Expires (mod_expires).
#
# Los bloques <IfModule nombre.c> ... </IfModule> evitan errores 500 si el
# hosting no carga ese módulo: Apache simplemente **omite** el bloque.
#
# Ensorlogs Web — rendimiento y seguridad (Apache / SiteGround)
# Si algo no aplica en tu plan, Apache ignora bloques <IfModule> vacíos.

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    # Evita sniffing de MIME en descargas desde esta carpeta
</IfModule>

# Sin listado de directorios
Options -Indexes

# HTTPS + redirecciones de URLs antiguas (misma regla mod_rewrite)
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Enlaces antiguos en la raíz → carpetas (301 + HTTPS en un solo salto)
    RewriteCond %{HTTP_HOST} ^(www\.)?ensorlogs\.com$ [NC]
    RewriteRule ^articulo-(.+\.html)$ https://%{HTTP_HOST}/articulos/$1 [R=301,L]
    # Slugs antiguos con prefix `articulo-` dentro de /articulos/ → sin prefix
    RewriteCond %{HTTP_HOST} ^(www\.)?ensorlogs\.com$ [NC]
    RewriteRule ^articulos/articulo-(.+\.html)$ https://%{HTTP_HOST}/articulos/$1 [R=301,L]
    RewriteCond %{HTTP_HOST} ^(www\.)?ensorlogs\.com$ [NC]
    RewriteRule ^proyecto-(.+\.html)$ https://%{HTTP_HOST}/proyectos/proyecto-$1 [R=301,L]
    # HTTPS solo en dominio de producción (no afecta localhost / preview local)
    RewriteCond %{HTTP_HOST} ^(www\.)?ensorlogs\.com$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 14 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType font/woff2 "access plus 180 days"
    ExpiresByType font/woff "access plus 180 days"
    ExpiresDefault "access plus 3 days"
</IfModule>
