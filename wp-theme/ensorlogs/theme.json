{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "appearanceTools": true,
        "color": {
            "background": true,
            "custom": true,
            "customDuotone": false,
            "customGradient": false,
            "defaultDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "link": true,
            "text": true,
            "palette": [
                {
                    "name": "Acento Ensorlogs",
                    "slug": "ensor-accent",
                    "color": "#d9a300"
                },
                {
                    "name": "Texto principal",
                    "slug": "ensor-ink",
                    "color": "#1a1a1a"
                },
                {
                    "name": "Texto secundario",
                    "slug": "ensor-mute",
                    "color": "#525866"
                },
                {
                    "name": "Fondo crema",
                    "slug": "ensor-page",
                    "color": "#faf8f3"
                },
                {
                    "name": "Fondo oscuro",
                    "slug": "ensor-night",
                    "color": "#0e0f10"
                },
                {
                    "name": "Borde sutil",
                    "slug": "ensor-edge",
                    "color": "#e6e6e2"
                }
            ]
        },
        "typography": {
            "customFontSize": false,
            "dropCap": false,
            "fontStyle": true,
            "fontWeight": true,
            "letterSpacing": true,
            "lineHeight": true,
            "textDecoration": true,
            "textTransform": true,
            "fontFamilies": [
                {
                    "name": "Bricolage Grotesque",
                    "slug": "bricolage",
                    "fontFamily": "'Bricolage Grotesque', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
                }
            ],
            "fontSizes": [
                {
                    "slug": "small",
                    "name": "S",
                    "size": "0.875rem"
                },
                {
                    "slug": "medium",
                    "name": "M",
                    "size": "1rem"
                },
                {
                    "slug": "large",
                    "name": "L",
                    "size": "1.25rem"
                },
                {
                    "slug": "x-large",
                    "name": "XL",
                    "size": "1.75rem"
                },
                {
                    "slug": "xx-large",
                    "name": "2XL",
                    "size": "2.5rem"
                }
            ]
        },
        "spacing": {
            "padding": true,
            "margin": true,
            "blockGap": true,
            "units": ["px", "rem", "em", "%", "vh", "vw"],
            "spacingScale": {
                "operator": "*",
                "increment": 1.5,
                "steps": 6,
                "mediumStep": 1,
                "unit": "rem"
            }
        },
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "layout": {
            "contentSize": "780px",
            "wideSize": "1180px"
        },
        "useRootPaddingAwareAlignments": false
    },
    "styles": {
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--bricolage)",
            "fontSize": "var(--wp--preset--font-size--medium)",
            "lineHeight": "1.6"
        },
        "elements": {
            "h1": {
                "typography": {
                    "fontWeight": "700",
                    "fontSize": "var(--wp--preset--font-size--xx-large)",
                    "lineHeight": "1.15"
                }
            },
            "h2": {
                "typography": {
                    "fontWeight": "700",
                    "fontSize": "var(--wp--preset--font-size--x-large)",
                    "lineHeight": "1.2"
                }
            },
            "h3": {
                "typography": {
                    "fontWeight": "600",
                    "fontSize": "var(--wp--preset--font-size--large)",
                    "lineHeight": "1.3"
                }
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--ensor-accent)"
                },
                ":hover": {
                    "typography": {
                        "textDecoration": "underline"
                    }
                }
            }
        },
        "blocks": {
            "core/quote": {
                "border": {
                    "color": "var(--wp--preset--color--ensor-edge)",
                    "style": "solid",
                    "width": "0 0 0 3px"
                },
                "spacing": {
                    "padding": {
                        "left": "1rem"
                    }
                }
            },
            "core/code": {
                "color": {
                    "background": "var(--wp--preset--color--ensor-edge)"
                },
                "spacing": {
                    "padding": {
                        "top": "0.5rem",
                        "right": "0.75rem",
                        "bottom": "0.5rem",
                        "left": "0.75rem"
                    }
                },
                "border": {
                    "radius": "6px"
                }
            }
        }
    }
}
